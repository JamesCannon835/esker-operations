# Copy this file to .env.local and fill in the values from your Supabase project.
# Supabase dashboard -> Project Settings -> API

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# "anon" / "publishable" key — safe in the browser; Row Level Security enforces access
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "service_role" / "secret" key — SERVER ONLY, bypasses all security.
# Needed for the admin "Users & roles" screen. Never prefix with NEXT_PUBLIC_.
# Also add this in Vercel -> Project -> Settings -> Environment Variables.
SUPABASE_SECRET_KEY=
